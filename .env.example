# Which model to use, as "<provider>:<model>".
# Providers: anthropic | openai | openrouter | gateway | compatible | claude-code
AI_MODEL=anthropic:claude-opus-5

# Only the key for the provider you actually use is required.
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=               # https://platform.openai.com/api-keys
OPENROUTER_API_KEY=           # https://openrouter.ai/keys
AI_GATEWAY_API_KEY=           # https://vercel.com/docs/ai-gateway

# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, Groq, Together...).
# Reachable as "compatible:<model>". Defaults to a local Ollama.
AI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
AI_COMPATIBLE_API_KEY=

# "claude-code:<model>" runs through a local Claude Code install and uses your
# Pro/Max subscription instead of an API key. Local/long-running hosts only —
# it spawns a CLI, so it will not work on edge or short-lived serverless.

# Optional OpenRouter app attribution — how this app is identified on
# OpenRouter's rankings and dashboard. Used by the client in lib/openrouter.ts.
# Browsing the model catalog needs no key; spending credits does.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Supermarket Info Display

# Supabase project settings (Project Settings > API).
# The publishable key is safe to expose to browser code. Never put a secret or
# service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local/admin inventory imports only. Never expose this key to browser code or
# deploy it under a NEXT_PUBLIC_* name.
SUPABASE_SERVICE_ROLE_KEY=
